theme_override_fonts/font = ExtResource("2_1och7")
theme_override_font_sizes/font_size = 30
text = "Quit"

[connection signal="tab_clicked" from="Control/TabContainer" to="." method="_on_tab_container_tab_clicked"]
[connection signal="mouse_entered" from="Control/TabContainer/System/VBoxContainer/Save" to="." method="_on_save_mouse_entered"]
[connection signal="pressed" from="Control/TabContainer/System/VBoxContainer/Save" to="." method="_on_save_pressed"]
[connection signal="mouse_entered" from="Control/TabContainer/System/VBoxContainer/Load" to="." method="_on_load_mouse_entered"]
[connection signal="pressed" from="Control/TabContainer/System/VBoxContainer/Load" to="." method="_on_load_pressed"]
[connection signal="mouse_entered" from="Control/TabContainer/System/VBoxContainer/Main Menu" to="." method="_on_main_menu_mouse_entered"]
[connection signal="pressed" from="Control/TabContainer/System/VBoxContainer/Main Menu" to="." method="_on_main_menu_pressed"]
[connection signal="mouse_entered" from="Control/TabContainer/System/VBoxContainer/Quit" to="." method="_on_quit_mouse_entered"]
[connection signal="pressed" from="Control/TabContainer/System/VBoxContainer/Quit" to="." method="_on_quit_pressed"]
